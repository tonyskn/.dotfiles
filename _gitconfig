[core]
   autocrlf = input
   editor = nvim
   ignorecase = false
   pager = delta
[color]
   ui = auto
[push]
   default = current
[user]
  name = Tony Elsokhon
  userConfigOnly = true
[include]
   path = ~/.git_aliases
[rebase]
   autoStash = true
[status]
   showUntrackedFiles = all
[interactive]
   diffFilter = delta --color-only
[delta]
   navigate = true
   line-numbers = true
   side-by-side = true
   hunk-header-style = omit
   file-style = bold yellow ul
   file-decoration-style = none
[diff]
   tool = nvimdiff
   colorMoved = default
[difftool]
   prompt = false
[remote "origin"]
   prune = true
   tagOpt = --tags
[filter "lfs"]
	smudge = git-lfs smudge -- %f
	process = git-lfs filter-process
	required = true
	clean = git-lfs clean -- %f

#!/usr/bin/env bun
// vim:ft=typescript
//
// _cl — data backend for the `cl` agent session manager.
// Manages bookmark JSONL, discovers live sessions, searches history, and drives tmux.
// No interactive UI — stdout is structured for fzf consumption.

import { exists, mkdir, rename } from "fs/promises";
import { homedir } from "os";
import { dirname, join } from "path";
import { parseArgs } from "util";
import {
  buildHistoryRows,
  buildSessionRows,
  getHarness,
  harnesses,
  iconForState,
  isAgentState,
  isHarnessId,
  sameSession,
  sessionKey,
  type BookmarkRecord,
  type Harness,
  type HistoryEntry,
  type LivePane,
  type SessionRef,
  type SessionRow,
} from "./model";

const HOME = homedir();

function run(strings: TemplateStringsArray, ...exprs: unknown[]) {
  return Bun.$(strings, ...exprs).nothrow().quiet();
}

// --- output ---

namespace Output {
  export function formatPath(path: string, marker = "", width = 40): string {
    const short = path.startsWith(HOME) ? "~" + path.slice(HOME.length) : path;
    return col(marker + short, width);
  }

  export function col(s: string, n: number): string {
    return s.padEnd(n).slice(0, n);
  }

  export function colRight(s: string, n: number): string {
    return s.padStart(n).slice(-n);
  }

  export function relTime(mins: number): string {
    if (mins < 1) return "just now";
    if (mins < 60) return `${Math.round(mins)}m ago`;
    if (mins < 1440) return `${Math.round(mins / 60)}h ago`;
    if (mins < 10080) return `${Math.round(mins / 1440)}d ago`;
    return `${Math.round(mins / 10080)}w ago`;
  }

  // Escape codes must wrap the joined row: col() pads by raw length, so coloring
  // individual columns before padding would break alignment.
  export function fzfRow(hidden: string[], display: string[], muted = false): void {
    const hiddenFields = hidden.join("\t");
    const displayFields = display.join("  ");
    const rendered = muted ? `\x1b[38;5;245m${displayFields}\x1b[0m` : displayFields;
    process.stdout.write(`${hiddenFields}\t${rendered}\n`);
  }

  // Also posts to the tmux status line so the message outlives popups.
  export function die(message: string): never {
    console.error(message);
    if (process.env.TMUX) Bun.spawnSync(["tmux", "display-message", `cl: ${message}`]);
    process.exit(1);
  }
}

// --- tmux ---

// Agent sessions identify themselves through pane options:
//
//   @cl_sid        session id
//   @cl_harness    harness id
//   @cl_state      working | idle | waiting | loop | attention
//   @cl_active_at  epoch seconds of the last agent event
//
// tmux-marker also derives window-level @cl_icon for the status bar.
namespace Tmux {
  type PaneTarget = Pick<LivePane, "windowId" | "paneId">;

  const FORMAT = [
    "#{@cl_harness}",
    "#{@cl_sid}",
    "#{window_id}",
    "#{pane_id}",
    "#{@cl_state}",
    "#{@cl_active_at}",
    "#{pane_current_command}",
    "#{pane_current_path}",
  ].join("\t");

  export async function panes(): Promise<LivePane[]> {
    const found: LivePane[] = [];

    for await (const line of run`tmux list-panes -a -F ${FORMAT}`.lines()) {
      const [
        harness,
        sid,
        windowId,
        paneId,
        state,
        activeAt,
        cmd,
        cwd,
      ] = line.split("\t");

      if (!isHarnessId(harness) || !sid || !windowId || !paneId) continue;
      if (!getHarness(harness).isProcess(cmd ?? "")) continue;

      found.push({
        harness,
        sid,
        windowId,
        paneId,
        state: isAgentState(state) ? state : undefined,
        activeAt: Number(activeAt) || 0,
        cwd: cwd ?? "",
      });
    }

    return found;
  }

  export async function find(ref: SessionRef): Promise<LivePane | undefined> {
    return (await panes()).find((pane) => sameSession(pane, ref));
  }

  export async function close(pane: LivePane): Promise<void> {
    await run`tmux kill-pane -t ${pane.paneId}`;
  }

  export async function rename(ref: SessionRef, name: string): Promise<void> {
    const pane = await find(ref);
    if (pane) await run`tmux rename-window -t ${pane.windowId} -- ${name.toUpperCase()}`;
  }

  async function focus(pane: PaneTarget): Promise<void> {
    await run`tmux select-window -t ${pane.windowId}`;
    await run`tmux select-pane -t ${pane.paneId}`;
  }

  async function paste(pane: LivePane, prompt: string): Promise<void> {
    await run`tmux load-buffer -b cl-prompt - < ${new Response(prompt)}`;
    await run`tmux paste-buffer -p -d -b cl-prompt -t ${pane.paneId}`;
    await run`tmux send-keys -t ${pane.paneId} Enter`;
  }

  async function launch(
    harness: Harness,
    name: string,
    cwd: string,
    command: string[],
  ): Promise<PaneTarget> {
    const windowArgs = [
      "new-window",
      "-d",
      "-c", cwd,
      "-n", name.toUpperCase(),
      "-PF", "#{window_id}",
      "--", ...command,
    ];
    const windowId = (await run`tmux ${windowArgs}`.text()).trim();

    const paneArgs = [
      "list-panes",
      "-t", windowId,
      "-F", "#{pane_id}",
    ];
    const paneId = (await run`tmux ${paneArgs}`.text()).trim().split("\n")[0];
    if (paneId) {
      await run`tmux set-option -p -t ${paneId} @cl_harness ${harness.id}`;
    }

    return { windowId, paneId };
  }

  export async function fork(
    source: SessionRef,
    name: string,
    cwd: string,
  ): Promise<void> {
    const harness = getHarness(source.harness);
    const command = harness.fork({ sourceSid: source.sid, name });
    const pane = await launch(harness, name, cwd, command);
    await focus(pane);
  }

  // Ensure a session has a running window, then focus or send a prompt.
  export async function open(
    ref: SessionRef,
    name: string,
    cwd: string,
    pane?: LivePane,
    prompt?: string,
  ): Promise<void> {
    if (!pane) {
      const harness = getHarness(ref.harness);
      const command = harness.resume({ sid: ref.sid, name, prompt });
      const launchedPane = await launch(harness, name, cwd, command);
      if (!prompt) await focus(launchedPane);
      return;
    }

    if (prompt) await paste(pane, prompt);
    else await focus(pane);
  }
}

// --- bookmarks ---

namespace Bookmarks {
  export function print(row: SessionRow): void {
    const live = row.pane !== undefined;
    const icon = live ? iconForState(row.pane?.state) || "-" : "";
    const savedMarker = row.saved ? "" : "* ";

    Output.fzfRow([row.harness, row.sid, row.name, row.pane?.paneId ?? ""], [
      Output.col(icon, 1),
      Output.colRight(Output.relTime(ageMins(row.lastActive)), 8),
      Output.col(savedMarker + row.name, 30),
      Output.formatPath(row.cwd),
      row.sid,
    ], !live);
  }

  const STATE_HOME = process.env.XDG_STATE_HOME || join(HOME, ".local", "state");
  const BOOKMARKS_PATH = join(STATE_HOME, "cl-tmux", "bookmarks.jsonl");
  let entries: BookmarkRecord[] = [];
  let dirty = false;

  function now(): number {
    return Math.floor(Date.now() / 1000);
  }

  export function ageMins(ts: number): number {
    return (now() - ts) / 60;
  }

  async function load(): Promise<void> {
    const file = Bun.file(BOOKMARKS_PATH);
    if (!(await file.exists())) return;

    const contents = await file.text();
    entries = contents
      .trim()
      .split("\n")
      .filter(Boolean)
      .map((line) => JSON.parse(line) as BookmarkRecord);
  }

  export const ready = load();

  export async function flush(): Promise<void> {
    if (!dirty) return;
    dirty = false;

    const contents = entries.map((entry) => JSON.stringify(entry)).join("\n") + "\n";
    const temporaryPath = BOOKMARKS_PATH + ".tmp";
    await mkdir(dirname(BOOKMARKS_PATH), { recursive: true });
    await Bun.write(temporaryPath, contents);
    await rename(temporaryPath, BOOKMARKS_PATH);
  }

  export function find(ref: SessionRef): BookmarkRecord | undefined {
    return entries.find((bookmark) => sameSession(bookmark, ref));
  }

  // A bookmark is only resumable while its directory and session file survive.
  export async function ensureLaunchable(bm: BookmarkRecord): Promise<void> {
    if (!(await exists(bm.cwd))) Output.die(`Directory no longer exists: ${bm.cwd}`);
    if (!(await History.get(bm))) Output.die(`No session history for '${bm.name}'`);
  }

  // No name/cwd: just marks it active. With name/cwd: creates or updates.
  export async function save(ref: SessionRef, name?: string, cwd?: string): Promise<void> {
    await ready;
    const existing = find(ref);

    if (existing) {
      if (name) existing.name = name;
      if (cwd) existing.cwd = cwd;
      dirty = true;
      return;
    }

    if (!name) Output.die("New bookmark requires --name");
    if (!cwd) {
      const pane = await Tmux.find(ref);
      cwd = pane?.cwd;
    }
    if (!cwd) Output.die("New bookmark requires --cwd (no live pane to infer from)");

    const timestamp = now();
    entries.push({
      ...ref,
      name,
      cwd,
      started: timestamp,
      lastActive: timestamp,
    });
    dirty = true;
  }

  export function remove(ref: SessionRef): void {
    entries = entries.filter((bookmark) => !sameSession(bookmark, ref));
    dirty = true;
  }

  export async function list(): Promise<SessionRow[]> {
    await ready;
    const panes = await Tmux.panes();
    const rows = buildSessionRows(entries, panes);
    const bookmarkBySession = new Map(entries.map((entry) => [sessionKey(entry), entry]));

    for (const row of rows) {
      const bookmark = bookmarkBySession.get(sessionKey(row));
      if (bookmark && row.lastActive > bookmark.lastActive) {
        bookmark.lastActive = row.lastActive;
        dirty = true;
      }
    }

    return Promise.all(
      rows.map(async (row) => {
        if (row.saved) return row;
        const history = await History.get(row);
        return { ...row, name: history?.name ?? row.name };
      }),
    );
  }
}

// --- history ---

namespace History {
  export function print(entry: HistoryEntry): void {
    const pathMarker = entry.cwdExists ? "" : "✗ ";
    Output.fzfRow([entry.harness, entry.sid, entry.name, entry.cwd], [
      Output.col(entry.title, 50),
      Output.col(entry.name, 30),
      Output.formatPath(entry.cwd, pathMarker),
      entry.sid,
    ]);
  }

  async function parse(harness: Harness, file: string): Promise<HistoryEntry> {
    const parsed = harness.parseHistory(file, await Bun.file(file).text());
    const cwdExists = Boolean(parsed.cwd) && await exists(parsed.cwd);
    return { harness: harness.id, ...parsed, cwdExists };
  }

  export async function search(term: string): Promise<HistoryEntry[]> {
    const matches: Array<{ harness: Harness; file: string }> = [];

    for (const harness of harnesses()) {
      const globArgs = harness.historyGlobs.flatMap((glob) => ["-g", glob]);
      const directory = join(HOME, harness.historyDir);
      const args = ["-ilF", ...globArgs, "--", term, directory];
      const result = await run`rg ${args}`.text();
      for (const file of result.trim().split("\n").filter(Boolean)) {
        matches.push({ harness, file });
      }
    }

    matches.sort((a, b) => Bun.file(b.file).lastModified - Bun.file(a.file).lastModified);
    const entries = await Promise.all(matches.map(({ harness, file }) => parse(harness, file)));
    return buildHistoryRows(entries);
  }

  export async function get(ref: SessionRef): Promise<HistoryEntry | undefined> {
    const harness = getHarness(ref.harness);
    const directory = join(HOME, harness.historyDir);
    const args = ["--files", "-g", harness.sessionGlob(ref.sid), directory];
    const file = (await run`rg ${args}`.text()).trim();
    if (!file) return undefined;

    const entry = await parse(harness, file);
    return buildHistoryRows([entry])[0];
  }
}

// --- commands ---

namespace Cli {
  const USAGE: Record<string, string> = {
    list:   "_cl list [--filter all|live|today|week]",
    save:   "_cl save <harness> <sid> [--name <name>] [--cwd <dir>]",
    open:   "_cl open <harness> <sid> [--prompt <text>]",
    fork:   "_cl fork <harness> <sid>",
    close:  "_cl close <harness> <sid>",
    delete: "_cl delete <harness> <sid>",
    search: "_cl search <term>",
  };

  const { positionals, values: flags } = parseArgs({
    allowPositionals: true,
    options: {
      prompt: { type: "string" },
      name:   { type: "string" },
      cwd:    { type: "string" },
      filter: { type: "string" },
    },
  });
  const [cmd, ...args] = positionals;

  // Prints the command's own usage if we recognise it, otherwise the full list.
  function die(): never {
    const lines = USAGE[cmd]
      ? [`Usage: ${USAGE[cmd]}`]
      : ["Usage:", ...Object.values(USAGE).map((u) => "  " + u)];
    Output.die(lines.join("\n"));
  }

  function arg(): string {
    return args[0] ?? die();
  }

  function ref(): SessionRef {
    const [harness, sid] = args;
    if (!harness || !isHarnessId(harness) || !sid) die();
    return { harness, sid };
  }

  async function session(target = ref()): Promise<SessionRow | undefined> {
    return (await Bookmarks.list()).find((row) => sameSession(row, target));
  }

  async function sessionOrDie(): Promise<SessionRow> {
    return (await session()) ?? Output.die("Session not found");
  }

  function matchesFilter(row: SessionRow): boolean {
    switch (flags.filter) {
      case "today": return Bookmarks.ageMins(row.lastActive) < 1440;
      case "week":  return Bookmarks.ageMins(row.lastActive) < 10080;
      case "live":  return row.pane !== undefined;
      default:      return true;
    }
  }

  export async function run(): Promise<void> {
    switch (cmd) {
      case "list": {
        const sessions = (await Bookmarks.list()).filter(matchesFilter);
        for (const row of sessions) Bookmarks.print(row);
        break;
      }

      case "save": {
        const target = ref();
        const renamed = flags.name !== undefined && Bookmarks.find(target)?.name !== flags.name;
        await Bookmarks.save(target, flags.name, flags.cwd);
        if (renamed && flags.name) await Tmux.rename(target, flags.name);
        break;
      }

      case "open": {
        const target = ref();
        const existing = await session(target);
        if (existing?.saved && !existing.pane) await Bookmarks.ensureLaunchable(existing);

        const name = existing?.name ?? flags.name ?? "unnamed";
        const cwd = existing?.cwd ?? flags.cwd;
        if (!cwd) Output.die("Need --cwd for unbookmarked session");

        await Tmux.open(
          target,
          name,
          cwd,
          existing?.pane,
          flags.prompt,
        );
        break;
      }

      case "fork": {
        const source = await sessionOrDie();
        await Bookmarks.ensureLaunchable(source);
        await Tmux.fork(
          source,
          source.name + "-fork",
          source.cwd,
        );
        break;
      }

      case "close": {
        const selected = await sessionOrDie();
        if (selected.pane) await Tmux.close(selected.pane);
        break;
      }

      case "delete": {
        const selected = await sessionOrDie();
        // Remove first so a tmux failure cannot strand the bookmark.
        Bookmarks.remove(selected);
        if (selected.pane) await Tmux.close(selected.pane);
        break;
      }

      case "search": {
        const results = await History.search(arg());
        for (const entry of results) History.print(entry);
        break;
      }

      default:
        die();
    }
  }
}

await Bookmarks.ready;
process.once("beforeExit", () => Bookmarks.flush()); // backstop; the flush below is the primary path
await Cli.run();
await Bookmarks.flush();

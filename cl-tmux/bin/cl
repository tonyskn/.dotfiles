#!/usr/bin/env bash
# vim:ft=bash
#
# cl — agent session manager.
# Picker for indexed agent sessions. Search across tracked transcripts.
#
# Usage:
#   cl                  fzf session picker
#
set -eo pipefail

dir="$(dirname "$(readlink -f "$0")")"
_cl() { "$dir/_cl" "$@"; }
gum_ui() {
  gum "$@" && return
  clear >&2
  return 1
}

# --- session picker ---
read -r current_pane current_window <<< "$(tmux display-message -p '#{pane_id} #{window_id}' 2>/dev/null)"
selected_pane=""
filter=$(tmux show-option -sv @cl_filter 2>/dev/null || printf all)
bookmarked_view=$(tmux show-option -sv @cl_bookmarked 2>/dev/null || printf 0)
search_query=""

header() {
  local mode="$filter"
  [[ -n "$search_query" ]] && mode="search: $search_query"
  [[ "$bookmarked_view" == 1 ]] && mode="$mode, bookmarked"
  printf "[%s]  enter:open  ctrl-t:send  ctrl-g:filter  ctrl-l:bookmarks  ctrl-r:search\n" "$mode"
  printf "ctrl-s:save  ctrl-o:fork  ctrl-y:preview  ctrl-x:close  ctrl-d:remove"
}

session_rows() {
  local output
  local -a args
  if [[ -n "$search_query" ]]; then
    args=(search)
  else
    args=(list "$current_pane" "$current_window" --filter "$filter")
  fi
  [[ "$bookmarked_view" == 1 ]] && args+=(--bookmarked)
  [[ -n "$search_query" ]] && args+=(-- "$search_query")
  output=$(_cl "${args[@]}")
  if [[ -n "$search_query" ]]; then
    rows="$output"
  else
    selected_pane=${output%%$'\n'*}
    rows=${output#*$'\n'}
    [[ "$rows" == "$output" ]] && rows=""
  fi
  [[ -n "$rows" ]] || rows=$'\t\t\t\t\tNo sessions found'
}

while true; do
  session_rows
  position=$(awk -F $'\t' -v pane="$selected_pane" 'pane != "" && $4 == pane { print NR; exit }' <<< "$rows")
  position=${position:-1}

  selection=$(
    printf '%s\n' "$rows" |
      fzf \
        --no-sort \
        --sync \
        --ansi \
        --expect=ctrl-d,ctrl-g,ctrl-l,ctrl-o,ctrl-r,ctrl-s,ctrl-t,ctrl-x \
        --delimiter=$'\t' \
        --with-nth=6 \
        --accept-nth=1,2,3 \
        --bind="start:pos($position)" \
        --bind='ctrl-u:half-page-up,ctrl-f:half-page-down' \
        --bind="focus:transform-footer:printf '%s' {5} | fold -s -w 80" \
        --footer=' ' \
        --header="$(header)" \
        --preview='[[ -n {4} ]] && tmux capture-pane -ept {4} 2>/dev/null' \
        --preview-window='right,80%,follow,hidden' \
        --bind='ctrl-y:toggle-preview'
  ) || {
    if [[ -n "$search_query" ]]; then
      search_query=""
      continue
    fi
    exit 0
  }

  key=$(head -n 1 <<< "$selection")
  IFS=$'\t' read -r harness sid name <<< "$(tail -n 1 <<< "$selection")"

  if [[ -z "$sid" && "$key" != ctrl-r && "$key" != ctrl-g && "$key" != ctrl-l ]]; then
    continue
  fi

  case "$key" in
    ctrl-l)
      if [[ "$bookmarked_view" == 1 ]]; then bookmarked_view=0; else bookmarked_view=1; fi
      tmux set-option -s @cl_bookmarked "$bookmarked_view"
      continue
      ;;
    ctrl-g)
      search_query=""
      case "$filter" in
        all) filter=live ;;
        live) filter=today ;;
        today) filter=week ;;
        *) filter=all ;;
      esac
      tmux set-option -s @cl_filter "$filter"
      continue
      ;;
    ctrl-r)
      search_query=$(gum_ui input --placeholder "Search conversations" --value "$search_query") || continue
      ;;
    ctrl-s)
      new_name=$(gum_ui input --placeholder "Name" --value "$name") || continue
      [[ -n "$new_name" ]] && _cl save "$harness" "$sid" --name "$new_name"
      ;;
    ctrl-o) _cl fork "$harness" "$sid" && exit 0 ;;
    ctrl-x) _cl close "$harness" "$sid" ;;
    ctrl-d)
      gum_ui confirm "Remove '$name' from cl-tmux?" || continue
      _cl remove "$harness" "$sid"
      ;;
    ctrl-t)
      prompt=$(gum_ui write --header "Prompt for $name" --width 80) || continue
      [[ -n "$prompt" ]] && _cl open "$harness" "$sid" --prompt "$prompt" && exit 0
      ;;
    *)
      _cl open "$harness" "$sid"
      exit 0
      ;;
  esac
done

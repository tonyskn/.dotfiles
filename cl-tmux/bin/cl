#!/usr/bin/env bash
# vim:ft=bash
#
# cl — agent session manager.
# Picker for bookmarked and live sessions. Search across harness session files.
#
# Usage:
#   cl                  fzf session picker
#   cl search <term>    search all configured harness session files
#
set -eo pipefail

dir="$(dirname "$(readlink -f "$0")")"
current_pane="$(tmux display-message -p '#{pane_id}' 2>/dev/null)"
_cl() { "$dir/_cl" "$@"; }
gum_ui() {
  gum "$@" && return
  clear >&2
  return 1
}

# --- search ---
search_sessions() {
  local term="${1:?Usage: cl search <term>}"
  local harness sid name cwd

  IFS=$'\t' read -r harness sid name cwd < <(
    _cl search -- "$term" |
      fzf \
        --no-sort \
        --ansi \
        --delimiter=$'\t' \
        --with-nth=5 \
        --accept-nth=1,2,3,4 \
        --header='enter: open'
  ) || true

  [[ -z "$sid" ]] && return 1

  if [[ ! -d "$cwd" ]]; then
    cwd=$(zoxide query -l | fzf --header="Original directory gone — pick a new one") || true
    [[ -z "$cwd" ]] && return 1
  fi

  _cl open "$harness" "$sid" --name "$name" --cwd "$cwd"
}

if [[ "${1:-}" == "search" ]]; then
  search_sessions "${2:-}" || true
  exit 0
fi

# --- session picker ---
filter=$(tmux show-option -sv @cl_filter 2>/dev/null || echo "all")

header() {
  printf "[%s]  enter:open  ctrl-t:send  ctrl-g:filter  ctrl-f:search\n" "$filter"
  printf "ctrl-s:save  ctrl-o:fork  ctrl-u:preview  ctrl-x:close  ctrl-d:remove"
}

session_rows() {
  local rows
  rows=$(_cl list --filter "$filter")
  if [[ -n "$rows" ]]; then
    printf '%s\n' "$rows"
  else
    printf '\t\t\t\tNo sessions found\n'
  fi
}

while true; do
  rows=$(session_rows)
  position=$(awk -F $'\t' -v pane="$current_pane" '$4 == pane { print NR; exit }' <<< "$rows")
  position=${position:-1}

  selection=$(
    printf '%s\n' "$rows" |
      fzf \
        --no-sort \
        --sync \
        --ansi \
        --expect=ctrl-d,ctrl-f,ctrl-g,ctrl-o,ctrl-s,ctrl-t,ctrl-x \
        --delimiter=$'\t' \
        --with-nth=5 \
        --accept-nth=1,2,3 \
        --bind="start:pos($position)" \
        --header="$(header)" \
        --preview='[[ -n {4} ]] && tmux capture-pane -ept {4} 2>/dev/null' \
        --preview-window='right,80%,follow,hidden' \
        --bind='ctrl-u:toggle-preview'
  ) || exit 0

  key=$(head -n 1 <<< "$selection")
  IFS=$'\t' read -r harness sid name <<< "$(tail -n 1 <<< "$selection")"

  if [[ -z "$sid" && "$key" != ctrl-f && "$key" != ctrl-g ]]; then
    continue
  fi

  case "$key" in
    ctrl-g)
      case "$filter" in
        all) filter=live ;;
        live) filter=today ;;
        today) filter=week ;;
        *) filter=all ;;
      esac
      tmux set-option -s @cl_filter "$filter" 2>/dev/null
      continue
      ;;
    ctrl-f)
      term=$(gum_ui input --placeholder "Search sessions...") || continue
      if [[ -n "$term" ]] && search_sessions "$term"; then
        exit 0
      fi
      ;;
    ctrl-s)
      new_name=$(gum_ui input --placeholder "Name" --value "$name") || continue
      [[ -n "$new_name" ]] && _cl save "$harness" "$sid" --name "$new_name"
      ;;
    ctrl-o) _cl fork "$harness" "$sid" && exit 0 ;;
    ctrl-x) _cl close "$harness" "$sid" ;;
    ctrl-d)
      gum_ui confirm "Remove '$name' from cl-tmux?" || continue
      _cl remove "$harness" "$sid"
      ;;
    ctrl-t)
      prompt=$(gum_ui write --header "Prompt for $name" --width 80) || continue
      [[ -n "$prompt" ]] && _cl open "$harness" "$sid" --prompt "$prompt" && exit 0
      ;;
    *)
      _cl open "$harness" "$sid"
      exit 0
      ;;
  esac
done

#!/usr/bin/env bun
// vim:ft=typescript
// Publishes agent session state to pane options and derives window status options.
//
//   tmux-marker [--harness <id>] [state]

import {
  aggregateIcon,
  getHarness,
  isAgentState,
  isHarnessId,
  type AgentState,
} from "./model";
import { parseArgs } from "util";

const paneId = process.env.TMUX_PANE;
if (!paneId) process.exit(0);

type HookPayload = {
  session_id?: unknown;
  hook_event_name?: unknown;
};

function tmux(args: string[]): { ok: boolean; stdout: string } {
  const result = Bun.spawnSync(["tmux", ...args], {
    stdout: "pipe",
    stderr: "ignore",
  });
  return {
    ok: result.exitCode === 0,
    stdout: result.stdout.toString().trim(),
  };
}

async function hookPayload(): Promise<HookPayload | undefined> {
  if (process.stdin.isTTY) return undefined;
  try {
    return await Bun.stdin.json();
  } catch {
    return undefined;
  }
}

const { positionals, values } = parseArgs({
  args: process.argv.slice(2),
  allowPositionals: true,
  options: { harness: { type: "string" } },
});
if (values.harness !== undefined && !isHarnessId(values.harness)) process.exit(0);

const explicitState = positionals[0] ?? "";
const taggedHarness = tmux([
  "display-message", "-p", "-t", paneId, "#{@cl_harness}",
]).stdout;
const harnessId = values.harness ?? taggedHarness;
if (!isHarnessId(harnessId)) process.exit(0);

const harness = getHarness(harnessId);
let state = isAgentState(explicitState) ? explicitState : undefined;
let sid = "";

const payload = await hookPayload();
if (payload) {
  if (typeof payload.session_id === "string") sid = payload.session_id;
  if (!explicitState && typeof payload.hook_event_name === "string") {
    state = harness.stateForHook(payload.hook_event_name);
  }
}

const activeAt = Math.floor(Date.now() / 1000);
const setPane = [
  "set-option", "-p", "-t", paneId, "@cl_harness", harness.id,
  ";", "set-option", "-p", "-t", paneId, "@cl_state", state ?? "",
  ";", "set-option", "-p", "-t", paneId, "@cl_active_at", String(activeAt),
];
if (sid) setPane.push(";", "set-option", "-p", "-t", paneId, "@cl_sid", sid);
if (!tmux(setPane).ok) process.exit(0);

const listed = tmux([
  "list-panes", "-a", "-F",
  "#{window_id}\t#{@cl_harness}\t#{@cl_state}",
]);
if (!listed.ok) process.exit(0);

const statesByWindow = new Map<string, AgentState[]>();
for (const line of listed.stdout.split("\n")) {
  const [windowId, paneHarness, paneState] = line.split("\t");
  if (!windowId) continue;

  const states = statesByWindow.get(windowId) ?? [];
  if (isHarnessId(paneHarness) && isAgentState(paneState)) states.push(paneState);
  statesByWindow.set(windowId, states);
}

for (const [windowId, states] of statesByWindow) {
  tmux(["set-option", "-w", "-t", windowId, "@cl_icon", aggregateIcon(states)]);
}

#!/usr/bin/env bun
// vim:ft=typescript
// Publishes agent session state to pane options and derives window status options.
//
//   tmux-marker [--harness <id>] [state]

import {
  AgentState,
  Harness,
} from "./model";
import { parseArgs } from "util";

const paneId = process.env.TMUX_PANE;
if (!paneId) process.exit(0);

type HookPayload = {
  session_id?: unknown;
  hook_event_name?: unknown;
};

function tmux(args: string[]): { ok: boolean; stdout: string } {
  const result = Bun.spawnSync(["tmux", ...args], {
    stdout: "pipe",
    stderr: "ignore",
  });
  return {
    ok: result.exitCode === 0,
    stdout: result.stdout.toString().trim(),
  };
}

function flushPane(options: ReadonlyArray<readonly [string, string]>): boolean {
  const args = options.flatMap(([option, value], index) => [
    ...(index ? [";"] : []),
    "set-option", "-p", "-t", paneId, option, value,
  ]);
  return tmux(args).ok;
}

async function hookPayload(): Promise<HookPayload | undefined> {
  if (process.stdin.isTTY) return undefined;
  try {
    return await Bun.stdin.json();
  } catch {
    return undefined;
  }
}

const { positionals, values } = parseArgs({
  args: process.argv.slice(2),
  allowPositionals: true,
  options: { harness: { type: "string" } },
});
if (values.harness !== undefined && !Harness.isId(values.harness)) process.exit(0);

const payload = await hookPayload();
const taggedHarness = tmux([
  "display-message", "-p", "-t", paneId, "#{@cl_harness}",
]).stdout;
const harnessId = values.harness ?? taggedHarness;
if (!Harness.isId(harnessId)) process.exit(0);

const harness = Harness.get(harnessId);
const requestedState = positionals[0] ?? "";
const hookState = typeof payload?.hook_event_name === "string"
  ? harness.stateForHook(payload.hook_event_name)
  : undefined;
const state = AgentState.is(requestedState) ? requestedState : hookState;
const sid = typeof payload?.session_id === "string" ? payload.session_id : undefined;

const paneOptions: Array<[string, string]> = [
  ["@cl_harness", harness.id],
  ["@cl_state", state ?? ""],
];
if (state) {
  paneOptions.push(["@cl_active_at", String(Math.floor(Date.now() / 1000))]);
}
if (sid) paneOptions.push(["@cl_sid", sid]);

if (!flushPane(paneOptions)) process.exit(0);

const listed = tmux([
  "list-panes", "-a", "-F",
  "#{window_id}\t#{@cl_harness}\t#{@cl_state}",
]);
if (!listed.ok) process.exit(0);

const statesByWindow = new Map<string, AgentState[]>();
for (const line of listed.stdout.split("\n")) {
  const [windowId, paneHarness, paneState] = line.split("\t");
  if (!windowId) continue;

  const states = statesByWindow.get(windowId) ?? [];
  if (Harness.isId(paneHarness) && AgentState.is(paneState)) states.push(paneState);
  statesByWindow.set(windowId, states);
}

for (const [windowId, states] of statesByWindow) {
  tmux(["set-option", "-w", "-t", windowId, "@cl_icon", AgentState.aggregate(states)]);
}

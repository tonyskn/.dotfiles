#!/usr/bin/env bun
// vim:ft=typescript
//
// _cl — data backend for the `cl` Claude session bookmark helper.
// Manages bookmark JSONL, searches Claude session history, and drives tmux windows.
// No interactive UI — stdout is structured for fzf consumption.

import { exists, rename } from "fs/promises";
import { homedir } from "os";
import { basename, join } from "path";
import { parseArgs } from "util";

const HOME = homedir();

// --- output ---

namespace Output {
  export function formatPath(path: string, marker = "", width = 40): string {
    const short = path.startsWith(HOME) ? "~" + path.slice(HOME.length) : path;
    return col(marker + short, width);
  }

  export function col(s: string, n: number): string {
    return s.padEnd(n).slice(0, n);
  }

  export function colRight(s: string, n: number): string {
    return s.padStart(n).slice(-n);
  }

  export function relTime(mins: number): string {
    if (mins < 1) return "just now";
    if (mins < 60) return `${Math.round(mins)}m ago`;
    if (mins < 1440) return `${Math.round(mins / 60)}h ago`;
    if (mins < 10080) return `${Math.round(mins / 1440)}d ago`;
    return `${Math.round(mins / 10080)}w ago`;
  }

  // Escape codes must wrap the joined row: col() pads by raw length, so dimming
  // individual columns before padding would break alignment.
  export function fzfRow(hidden: string[], display: string[], dim = false): void {
    const row = display.join("  ");
    process.stdout.write(hidden.join("\t") + "\t" + (dim ? `\x1b[2m${row}\x1b[0m` : row) + "\n");
  }

  // Also posts to the tmux status line so the message outlives popups.
  export function die(message: string): never {
    console.error(message);
    if (process.env.TMUX) Bun.spawnSync(["tmux", "display-message", `cl: ${message}`]);
    process.exit(1);
  }
}

// --- tmux ---

namespace Tmux {
  interface Window {
    name: string;
    id: string; // stable #{window_id} (@N) — indices shift under renumber-windows
    icon: string; // one of ●○◐, or "-" for an open window with no marker
  }

  export function windowName(name: string): string {
    return name.toUpperCase();
  }

  async function windows(): Promise<Window[]> {
    const wins: Window[] = [];
    for await (const line of Bun.$`tmux list-windows -F '#{window_id}|#{window_name}'`.nothrow().quiet().lines()) {
      // Rejoin after the first "|": window names may contain one.
      const [id, ...rest] = line.split("|");
      if (!id || !rest.length) continue;
      const raw = rest.join("|");
      const [, icon, name] = raw.match(/^([●○◐]) (.+)$/) ?? [];
      wins.push({ id, name: name ?? raw, icon: icon ?? "-" });
    }
    return wins;
  }

  export async function iconMap(): Promise<Record<string, string>> {
    return Object.fromEntries((await windows()).map((w) => [w.name, w.icon]));
  }

  async function findWindow(name: string): Promise<Window | null> {
    return (await windows()).find((w) => w.name === windowName(name)) ?? null;
  }

  export async function closeWindow(name: string): Promise<void> {
    const win = await findWindow(name);
    if (win) await Bun.$`tmux kill-window -t ${win.id}`.nothrow().quiet();
  }

  // With oldName: rename that window, keeping its status icon. Without: rename the current window.
  export async function renameWindow(newName: string, oldName?: string): Promise<void> {
    if (!oldName) {
      if (!process.env.TMUX) return;
      await Bun.$`tmux rename-window -- ${windowName(newName)}`.nothrow().quiet();
      return;
    }
    const win = await findWindow(oldName);
    if (!win) return;
    const prefix = win.icon === "-" ? "" : win.icon + " ";
    await Bun.$`tmux rename-window -t ${win.id} -- ${prefix + windowName(newName)}`.nothrow().quiet();
  }

  async function sendPrompt(paneTarget: string, prompt: string): Promise<void> {
    // Claude's binary is named after its version (e.g. "2.1.212"), and running
    // sessions keep old versions alive — so accept any bare-version process name.
    const fg = (await Bun.$`tmux display-message -p -t ${paneTarget} '#{pane_current_command}'`.nothrow().quiet().text()).trim();
    const isClaude = /^\d+\.\d+\.\d+$/.test(fg) || ["claude", "node", "bun"].includes(fg);
    if (!isClaude) Output.die(`Pane is running '${fg}', not claude — refusing to send prompt`);

    // -p: bracketed paste, so multiline prompts don't submit line by line
    await Bun.$`tmux load-buffer -b cl-prompt - < ${new Response(prompt)}`.nothrow().quiet();
    await Bun.$`tmux paste-buffer -p -d -b cl-prompt -t ${paneTarget}`.nothrow().quiet();
    await Bun.$`tmux send-keys -t ${paneTarget} Enter`.nothrow().quiet();
  }

  // argv passes straight through tmux (no shell), so names/prompts need no quoting.
  export async function openSession(sid: string, name: string, cwd: string, prompt?: string): Promise<void> {
    const winName = windowName(name);
    const win = await findWindow(name);

    if (win) {
      if (!prompt) await Bun.$`tmux select-window -t ${win.id}`.nothrow().quiet();
      await Bun.$`tmux select-pane -t ${win.id}.0`.nothrow().quiet();
      if (prompt) await sendPrompt(`${win.id}.0`, prompt);
      return;
    }

    const claudeArgs = ["--resume", sid, "-n", name, ...(prompt ? [prompt] : [])];
    const background = prompt ? ["-d"] : []; // don't steal focus when only sending a prompt
    await Bun.$`tmux new-window ${background} -c ${cwd} -n ${winName} -- claude ${claudeArgs}`.nothrow().quiet();
  }

  export async function forkSession(srcSid: string, newSid: string, name: string, cwd: string): Promise<void> {
    const claudeArgs = ["--resume", srcSid, "--fork-session", "--session-id", newSid, "-n", name];
    await Bun.$`tmux new-window -c ${cwd} -n ${windowName(name)} -- claude ${claudeArgs}`.nothrow().quiet();
  }
}

// --- bookmarks ---

namespace Bookmarks {
  export interface Entry {
    sid: string;
    name: string;
    cwd: string;
    started: string;
    accessed: string;
    icon?: string;
  }

  const STALE_MIN = 7 * 1440;

  export function print(bm: Entry): void {
    const age = ageMin(bm.accessed);
    Output.fzfRow([bm.sid, bm.name], [
      Output.col(bm.icon ?? "", 1),
      Output.colRight(Output.relTime(age), 8),
      Output.col(bm.name, 30),
      Output.formatPath(bm.cwd),
      bm.sid,
    ], age > STALE_MIN);
  }

  const PATH = join(HOME, ".claude", "bookmarks.jsonl");
  let entries: Entry[] = [];
  let dirty = false;

  // Stored as UTC "YYYY-MM-DD HH:MM" — timestamp() and ageMin() are a pair.
  function timestamp(): string {
    return new Date().toISOString().replace("T", " ").slice(0, 16);
  }

  function ageMin(ts: string): number {
    return (Date.now() - new Date(ts.replace(" ", "T") + "Z").getTime()) / 60_000;
  }

  async function load(): Promise<void> {
    const file = Bun.file(PATH);
    if (!(await file.exists())) return;
    entries = (await file.text())
      .trim()
      .split("\n")
      .filter(Boolean)
      .flatMap((line) => {
        try {
          return [JSON.parse(line)];
        } catch {
          return []; // skip malformed lines instead of bricking every command
        }
      });
  }

  export const ready = load();

  // Atomic write: temp file + rename so a crash can't truncate the store.
  export async function flush(): Promise<void> {
    if (!dirty) return;
    dirty = false;
    const clean = entries.map(({ icon, ...rest }) => rest);
    const tmp = PATH + ".tmp";
    await Bun.write(tmp, clean.map((e) => JSON.stringify(e)).join("\n") + "\n");
    await rename(tmp, PATH);
  }

  export function find(sid: string): Entry | undefined {
    return entries.find((b) => b.sid === sid);
  }

  // Unlike find(), dies rather than returning undefined.
  export function get(sid: string): Entry {
    return find(sid) ?? Output.die(`Bookmark not found: ${sid}`);
  }

  // A bookmark is only resumable while its directory and session file survive.
  export async function ensureLaunchable(bm: Entry): Promise<void> {
    if (!(await exists(bm.cwd))) Output.die(`Directory no longer exists: ${bm.cwd}`);
    if (!(await Sessions.fileExists(bm.sid))) {
      Output.die(`No Claude session file for '${bm.name}' — deleted or rotated by /clear`);
    }
  }

  // No name/cwd: bumps accessed. With name/cwd: creates or updates.
  export function save(sid: string, name?: string, cwd?: string): void {
    const existing = find(sid);
    const now = timestamp();
    if (existing) {
      if (name) existing.name = name;
      if (cwd) existing.cwd = cwd;
      existing.accessed = now;
    } else {
      if (!name || !cwd) Output.die("New bookmark requires --name and --cwd");
      entries.push({ sid, cwd, name, started: now, accessed: now });
    }
    dirty = true;
  }

  export function remove(sid: string): void {
    entries = entries.filter((b) => b.sid !== sid);
    dirty = true;
  }

  export async function list(): Promise<Entry[]> {
    if (!entries.length) return [];
    const icons = await Tmux.iconMap();
    return entries
      .map((bm) => ({ ...bm, icon: icons[Tmux.windowName(bm.name)] }))
      .sort((a, b) => b.accessed.localeCompare(a.accessed));
  }
}

// --- sessions ---

namespace Sessions {
  export interface Record {
    sid: string;
    title: string;
    name: string;
    cwd: string;
    gone: boolean; // cwd no longer exists on disk
  }

  export function print(r: Record): void {
    Output.fzfRow([r.sid, r.name, r.cwd], [
      Output.col(r.title, 50),
      Output.col(r.name, 30),
      Output.formatPath(r.cwd, r.gone ? "✗ " : ""),
      r.sid,
    ]);
  }

  const DIR = join(HOME, ".claude", "projects");

  async function parse(file: string): Promise<Record> {
    const sid = basename(file, ".jsonl");
    const lines = (await Bun.file(file).text()).trim().split("\n");
    let title = "", name = "", cwd = "";
    for (const line of lines) {
      try {
        const obj = JSON.parse(line);
        if (obj.type === "ai-title" && !title) title = obj.aiTitle || "";
        if (obj.type === "custom-title" && !name) name = obj.customTitle || "";
        if (obj.type === "user" && !cwd) cwd = obj.cwd || "";
        if (title && name && cwd) break;
      } catch {}
    }
    const gone = !cwd || !(await exists(cwd));
    return { sid, title: title || "untitled", name: name || "unnamed", cwd, gone };
  }

  export async function search(term: string): Promise<Record[]> {
    // -F: literal term; -e: terms starting with "-"; nothrow: grep exits 1 on no match
    const result = await Bun.$`grep -rilF ${"--include=*.jsonl"} --exclude-dir=subagents -e ${term} ${DIR}`.nothrow().quiet().text();
    const files = result.trim().split("\n").filter(Boolean);
    files.sort((a, b) => Bun.file(b).lastModified - Bun.file(a).lastModified);
    return Promise.all(files.map(parse));
  }

  export async function fileExists(sid: string): Promise<boolean> {
    const result = await Bun.$`find ${DIR} -name ${sid + ".jsonl"} -print -quit`.nothrow().quiet().text();
    return result.trim().length > 0;
  }
}

// --- commands ---

namespace Cli {
  const USAGE: Record<string, string> = {
    list:   "_cl list",
    save:   "_cl save <sid> [--name <name>] [--cwd <dir>] [--rename-window]",
    open:   "_cl open <sid> [--prompt <text>]",
    fork:   "_cl fork <sid> --name <name>",
    close:  "_cl close <sid>",
    delete: "_cl delete <sid>",
    search: "_cl search <term>",
  };

  const { positionals, values: flags } = parseArgs({
    allowPositionals: true,
    options: {
      prompt: { type: "string" },
      name:   { type: "string" },
      cwd:    { type: "string" },
      "rename-window": { type: "boolean" },
    },
  });
  const [cmd, ...args] = positionals;

  // Prints the command's own usage if we recognise it, otherwise the full list.
  function die(): never {
    const lines = USAGE[cmd]
      ? [`Usage: ${USAGE[cmd]}`]
      : ["Usage:", ...Object.values(USAGE).map((u) => "  " + u)];
    Output.die(lines.join("\n"));
  }

  // Every command takes exactly one positional: a session id, or a search term.
  function arg(): string {
    return args[0] ?? die();
  }

  export async function run(): Promise<void> {
    switch (cmd) {
      case "list": {
        for (const bm of await Bookmarks.list()) Bookmarks.print(bm);
        break;
      }

      case "save": {
        const sid = arg();
        const oldName = Bookmarks.find(sid)?.name;
        Bookmarks.save(sid, flags.name, flags.cwd);
        if (flags.name && oldName && oldName !== flags.name) {
          await Tmux.renameWindow(flags.name, oldName);
        }
        if (flags["rename-window"] && flags.name) await Tmux.renameWindow(flags.name);
        break;
      }

      case "open": {
        const sid = arg();
        const bm = Bookmarks.get(sid);
        await Bookmarks.ensureLaunchable(bm);
        Bookmarks.save(sid);
        await Tmux.openSession(sid, bm.name, bm.cwd, flags.prompt);
        break;
      }

      case "fork": {
        const src = Bookmarks.get(arg());
        await Bookmarks.ensureLaunchable(src);
        const name = flags.name ?? die();
        const newSid = crypto.randomUUID();
        Bookmarks.save(newSid, name, src.cwd);
        await Tmux.forkSession(src.sid, newSid, name, src.cwd);
        break;
      }

      case "close": {
        await Tmux.closeWindow(Bookmarks.get(arg()).name);
        break;
      }

      case "delete": {
        const bm = Bookmarks.get(arg());
        Bookmarks.remove(bm.sid); // remove first so a tmux failure can't strand the bookmark
        await Tmux.closeWindow(bm.name);
        break;
      }

      case "search": {
        for (const r of await Sessions.search(arg())) Sessions.print(r);
        break;
      }

      default:
        die();
    }
  }
}

await Bookmarks.ready;
process.once("beforeExit", () => Bookmarks.flush()); // backstop; the flush below is the primary path
await Cli.run();
await Bookmarks.flush();

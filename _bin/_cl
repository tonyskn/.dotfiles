#!/usr/bin/env bun
// vim:ft=typescript
//
// _cl — data backend for the `cl` Claude session manager.
// Manages bookmark JSONL, discovers live sessions, searches history, and drives tmux.
// No interactive UI — stdout is structured for fzf consumption.

import { exists, rename } from "fs/promises";
import { homedir } from "os";
import { basename, join } from "path";
import { parseArgs } from "util";

const HOME = homedir();

function $(strings: TemplateStringsArray, ...exprs: unknown[]) {
  return Bun.$(strings, ...exprs).nothrow().quiet();
}

// --- output ---

namespace Output {
  export function formatPath(path: string, marker = "", width = 40): string {
    const short = path.startsWith(HOME) ? "~" + path.slice(HOME.length) : path;
    return col(marker + short, width);
  }

  export function col(s: string, n: number): string {
    return s.padEnd(n).slice(0, n);
  }

  export function colRight(s: string, n: number): string {
    return s.padStart(n).slice(-n);
  }

  export function relTime(mins: number): string {
    if (mins < 1) return "just now";
    if (mins < 60) return `${Math.round(mins)}m ago`;
    if (mins < 1440) return `${Math.round(mins / 60)}h ago`;
    if (mins < 10080) return `${Math.round(mins / 1440)}d ago`;
    return `${Math.round(mins / 10080)}w ago`;
  }

  // Escape codes must wrap the joined row: col() pads by raw length, so coloring
  // individual columns before padding would break alignment.
  export function fzfRow(hidden: string[], display: string[], muted = false): void {
    const row = display.join("  ");
    process.stdout.write(hidden.join("\t") + "\t" + (muted ? `\x1b[38;5;245m${row}\x1b[0m` : row) + "\n");
  }

  // Also posts to the tmux status line so the message outlives popups.
  export function die(message: string): never {
    console.error(message);
    if (process.env.TMUX) Bun.spawnSync(["tmux", "display-message", `cl: ${message}`]);
    process.exit(1);
  }
}

// --- tmux ---

// Claude sessions identify themselves through tmux user options:
//
//   @cl_sid        window   the claude session id
//   @cl_icon       window   status glyph (● working, ○ idle, ◐ waiting, ↻ loop, ⚠ attention)
//   @cl_active_at  window   epoch seconds of the last claude event
//   @cl_pane       pane     marks which pane actually runs claude
//
// Window options are visible from every pane in the window, pane options are not —
// which is what makes @cl_pane a usable selector for the claude pane specifically.
//
// tmux-marker sets these on every Claude hook, making sessions self-registering.
namespace Tmux {
  export interface Window {
    sid: string;
    id: string;
    paneId: string;
    icon: string;
    activeAt: number;
    cwd: string;
  }

  const FORMAT = [
    "#{@cl_pane}",
    "#{@cl_sid}",
    "#{window_id}",
    "#{pane_id}",
    "#{@cl_icon}",
    "#{@cl_active_at}",
    "#{pane_current_command}",
    "#{pane_current_path}",
  ].join("|");

  function isClaude(cmd: string): boolean {
    return /^\d+\.\d+\.\d+$/.test(cmd) || ["claude", "node", "bun"].includes(cmd);
  }

  export async function windows(): Promise<Window[]> {
    const found: Window[] = [];

    for await (const line of $`tmux list-panes -a -F ${FORMAT}`.lines()) {
      const [marked, sid, id, paneId, icon, activeAt, cmd, cwd] = line.split("|");
      if (marked !== "1" || !sid || !id) continue;
      if (!isClaude(cmd ?? "")) continue;

      found.push({
        sid,
        id,
        paneId: paneId ?? "",
        icon: icon ?? "",
        activeAt: Number(activeAt) || 0,
        cwd: cwd ?? "",
      });
    }

    return found;
  }

  export async function close(win: Window): Promise<void> {
    await $`tmux kill-window -t ${win.id}`;
  }

  export async function rename(sid: string, name: string): Promise<void> {
    const win = (await windows()).find((w) => w.sid === sid);
    if (win) await $`tmux rename-window -t ${win.id} -- ${name.toUpperCase()}`;
  }

  async function focus(win: Window): Promise<void> {
    await $`tmux select-window -t ${win.id}`;
    await $`tmux select-pane -t ${win.paneId}`;
  }

  async function paste(win: Window, prompt: string): Promise<void> {
    await $`tmux load-buffer -b cl-prompt - < ${new Response(prompt)}`;
    await $`tmux paste-buffer -p -d -b cl-prompt -t ${win.paneId}`;
    await $`tmux send-keys -t ${win.paneId} Enter`;
  }

  async function launch(sid: string, name: string, cwd: string, claudeArgs: string[]): Promise<Window> {
    const id = (await $`tmux new-window -d -c ${cwd} -n ${name.toUpperCase()} -PF ${"#{window_id}"} -- claude ${claudeArgs}`
      .text()).trim();

    const paneId = (await $`tmux list-panes -t ${id} -F ${"#{pane_id}"}`.text()).trim().split("\n")[0] ?? "";
    await $`tmux set-option -w -t ${id} @cl_sid ${sid} ${";"} set-option -p -t ${paneId || id + ".0"} @cl_pane 1`;

    return { sid, id, paneId, icon: "", activeAt: 0, cwd };
  }

  export async function fork(srcSid: string, newSid: string, name: string, cwd: string): Promise<void> {
    const win = await launch(newSid, name, cwd,
      ["--resume", srcSid, "--fork-session", "--session-id", newSid, "-n", name]);
    await focus(win);
  }

  // Ensure a session has a running window, then focus or send a prompt.
  export async function open(sid: string, name: string, cwd: string, win?: Window, prompt?: string): Promise<void> {
    if (!win) {
      win = await launch(sid, name, cwd, ["--resume", sid, "-n", name, ...(prompt ? [prompt] : [])]);
    }

    if (prompt) await paste(win, prompt);
    else await focus(win);
  }
}

// --- bookmarks ---

namespace Bookmarks {
  export interface Bookmark {
    sid: string;
    name: string;
    cwd: string;
    started: string;
    lastActive: string;
    window?: Tmux.Window;
  }

  export function print(s: Bookmark): void {
    const live = s.window !== undefined;
    const age = ageMins(s.lastActive);
    Output.fzfRow([s.sid, s.name], [
      Output.col(live ? (s.window!.icon || "-") : "", 1),
      Output.colRight(Output.relTime(age), 8),
      Output.col(s.name, 30),
      Output.formatPath(s.cwd),
      s.sid,
    ], !live);
  }

  const PATH = join(HOME, ".claude", "bookmarks.jsonl");
  let entries: Bookmark[] = [];
  let dirty = false;

  // ISO 8601 UTC: parses back with no massaging, and sorts lexicographically.
  function timestamp(ms = Date.now()): string {
    return new Date(ms).toISOString();
  }

  export function ageMins(ts: string): number {
    return (Date.now() - new Date(ts).getTime()) / 60_000;
  }

  async function load(): Promise<void> {
    const file = Bun.file(PATH);
    if (!(await file.exists())) return;
    entries = (await file.text())
      .trim()
      .split("\n")
      .filter(Boolean)
      .flatMap((line) => {
        try {
          return [JSON.parse(line)];
        } catch {
          return []; // skip malformed lines instead of bricking every command
        }
      });
  }

  export const ready = load();

  export async function flush(): Promise<void> {
    if (!dirty) return;
    dirty = false;
    const tmp = PATH + ".tmp";
    await Bun.write(tmp, entries.map(({ window, ...rest }) => JSON.stringify(rest)).join("\n") + "\n");
    await rename(tmp, PATH);
  }

  export function find(sid: string): Bookmark | undefined {
    return entries.find((b) => b.sid === sid);
  }

  // A bookmark is only resumable while its directory and session file survive.
  export async function ensureLaunchable(bm: Bookmark): Promise<void> {
    if (!(await exists(bm.cwd))) Output.die(`Directory no longer exists: ${bm.cwd}`);
    if (!(await Sessions.fileExists(bm.sid))) {
      Output.die(`No Claude session file for '${bm.name}' — deleted or rotated by /clear`);
    }
  }

  // No name/cwd: just marks it active. With name/cwd: creates or updates.
  export async function save(sid: string, name?: string, cwd?: string): Promise<void> {
    await ready;
    const existing = find(sid);
    if (existing) {
      if (name) existing.name = name;
      if (cwd) existing.cwd = cwd;
    } else {
      if (!name) Output.die("New bookmark requires --name");
      if (!cwd) {
        const win = (await Tmux.windows()).find((w) => w.sid === sid);
        cwd = win?.cwd;
      }
      if (!cwd) Output.die("New bookmark requires --cwd (no live window to infer from)");
      const now = timestamp();
      entries.push({ sid, cwd, name, started: now, lastActive: now });
    }
    dirty = true;
  }

  export function remove(sid: string): void {
    entries = entries.filter((b) => b.sid !== sid);
    dirty = true;
  }

  export async function list(): Promise<Bookmark[]> {
    await ready;
    const windows = await Tmux.windows();
    const windowBySid = new Map(windows.map((w) => [w.sid, w]));
    const bookmarkedSids = new Set(entries.map((e) => e.sid));

    const bookmarked = entries.map((bm) => {
      const window = windowBySid.get(bm.sid);
      if (window?.activeAt) {
        const seen = timestamp(window.activeAt * 1000);
        if (seen > bm.lastActive) {
          bm.lastActive = seen;
          dirty = true;
        }
      }
      return { ...bm, window };
    });

    const orphans = windows
      .filter((w) => !bookmarkedSids.has(w.sid))
      .map((window) => {
        const now = timestamp(window.activeAt ? window.activeAt * 1000 : undefined);
        return {
          sid: window.sid,
          name: "unnamed",
          cwd: window.cwd,
          started: now,
          lastActive: now,
          window,
        };
      });

    return [...bookmarked, ...orphans]
      .sort((a, b) => b.lastActive.localeCompare(a.lastActive));
  }
}

// --- sessions ---

namespace Sessions {
  export interface Record {
    sid: string;
    title: string;
    name: string;
    cwd: string;
    gone: boolean; // cwd no longer exists on disk
  }

  export function print(r: Record): void {
    Output.fzfRow([r.sid, r.name, r.cwd], [
      Output.col(r.title, 50),
      Output.col(r.name, 30),
      Output.formatPath(r.cwd, r.gone ? "✗ " : ""),
      r.sid,
    ]);
  }

  const DIR = join(HOME, ".claude", "projects");

  async function parse(file: string): Promise<Record> {
    const sid = basename(file, ".jsonl");
    const lines = (await Bun.file(file).text()).trim().split("\n");
    let title = "", name = "", cwd = "";
    for (const line of lines) {
      try {
        const obj = JSON.parse(line);
        if (obj.type === "ai-title" && !title) title = obj.aiTitle || "";
        if (obj.type === "custom-title" && !name) name = obj.customTitle || "";
        if (obj.type === "user" && !cwd) cwd = obj.cwd || "";
        if (title && name && cwd) break;
      } catch {}
    }
    const gone = !cwd || !(await exists(cwd));
    return { sid, title: title || "untitled", name: name || "unnamed", cwd, gone };
  }

  export async function search(term: string): Promise<Record[]> {
    // -F: literal term; -e: terms starting with "-"; nothrow: grep exits 1 on no match
    const result = await $`grep -rilF ${"--include=*.jsonl"} --exclude-dir=subagents -e ${term} ${DIR}`.text();
    const files = result.trim().split("\n").filter(Boolean);
    files.sort((a, b) => Bun.file(b).lastModified - Bun.file(a).lastModified);
    return Promise.all(files.map(parse));
  }

  export async function fileExists(sid: string): Promise<boolean> {
    const result = await $`find ${DIR} -name ${sid + ".jsonl"} -print -quit`.text();
    return result.trim().length > 0;
  }
}

// --- commands ---

namespace Cli {
  const USAGE: Record<string, string> = {
    list:   "_cl list [--filter all|live|today|week]",
    save:   "_cl save <sid> [--name <name>] [--cwd <dir>]",
    open:   "_cl open <sid> [--prompt <text>]",
    fork:   "_cl fork <sid>",
    close:  "_cl close <sid>",
    delete: "_cl delete <sid>",
    search: "_cl search <term>",
  };

  const { positionals, values: flags } = parseArgs({
    allowPositionals: true,
    options: {
      prompt: { type: "string" },
      name:   { type: "string" },
      cwd:    { type: "string" },
      filter: { type: "string" },
    },
  });
  const [cmd, ...args] = positionals;

  // Prints the command's own usage if we recognise it, otherwise the full list.
  function die(): never {
    const lines = USAGE[cmd]
      ? [`Usage: ${USAGE[cmd]}`]
      : ["Usage:", ...Object.values(USAGE).map((u) => "  " + u)];
    Output.die(lines.join("\n"));
  }

  // Every command takes exactly one positional: a session id, or a search term.
  function arg(): string {
    return args[0] ?? die();
  }

  async function bookmark(sid = arg()): Promise<Bookmarks.Bookmark | undefined> {
    return (await Bookmarks.list()).find((s) => s.sid === sid);
  }

  async function bookmarkOrDie(): Promise<Bookmarks.Bookmark> {
    return await bookmark() ?? Output.die("Session not found");
  }

  export async function run(): Promise<void> {
    switch (cmd) {
      case "list": {
        const sessions = (await Bookmarks.list()).filter((s) => {
          switch (flags.filter) {
            case "today": return Bookmarks.ageMins(s.lastActive) < 1440;
            case "week":  return Bookmarks.ageMins(s.lastActive) < 10080;
            case "live":  return s.window !== undefined;
            default:      return true;
          }
        });
        for (const s of sessions) Bookmarks.print(s);
        break;
      }

      case "save": {
        const sid = arg();
        const renamed = flags.name && Bookmarks.find(sid)?.name !== flags.name;
        await Bookmarks.save(sid, flags.name, flags.cwd);
        if (renamed && flags.name) await Tmux.rename(sid, flags.name);
        break;
      }

      case "open": {
        const sid = arg();
        const bm = await bookmark(sid);
        if (bm && !bm.window) await Bookmarks.ensureLaunchable(bm);
        await Tmux.open(
          sid,
          bm?.name ?? "unnamed",
          bm?.cwd ?? flags.cwd ?? Output.die("Need --cwd for unbookmarked session"),
          bm?.window,
          flags.prompt,
        );
        break;
      }

      case "fork": {
        const src = await bookmarkOrDie();
        await Bookmarks.ensureLaunchable(src);
        await Tmux.fork(src.sid, crypto.randomUUID(), "unnamed", src.cwd);
        break;
      }

      case "close": {
        const s = await bookmarkOrDie();
        if (s.window) await Tmux.close(s.window);
        break;
      }

      case "delete": {
        const s = await bookmarkOrDie();
        Bookmarks.remove(s.sid); // remove first so a tmux failure can't strand the bookmark
        if (s.window) await Tmux.close(s.window);
        break;
      }

      case "search": {
        for (const r of await Sessions.search(arg())) Sessions.print(r);
        break;
      }

      default:
        die();
    }
  }
}

await Bookmarks.ready;
process.once("beforeExit", () => Bookmarks.flush()); // backstop; the flush below is the primary path
await Cli.run();
await Bookmarks.flush();

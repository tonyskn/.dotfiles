#!/usr/bin/env bash
# fzf directory picker powered by zoxide
# Prints the selected directory (or worktree) for the zsh widget to enter.
set -euo pipefail

out="$(zoxide query -l | fzf \
  --reverse --scheme=path +m \
  --expect=ctrl-g,ctrl-t \
  --header='enter: cd | ctrl-g: tmux window | ctrl-t: worktrees')"

key="${out%%$'\n'*}"
dir="${out#*$'\n'}"

[[ -z "$dir" ]] && exit 0

dir="$(cd "$dir" && pwd -P)"

case "$key" in
  ctrl-g)
    if [[ -n "${TMUX:-}" ]]; then
      tmux new-window -c "$dir"
    else
      printf '%s\n' "$dir"
    fi
    ;;
  ctrl-t) (caller="$PWD"; cd "$dir" && GWT_RETURN_DIR="$caller" command gwt) ;;
  *) printf '%s\n' "$dir" ;;
esac

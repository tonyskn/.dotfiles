#!/usr/bin/env bash
# vim:ft=bash
#
# cl — Claude session manager.
# Picker for all Claude sessions: bookmarked and live. Search across history.
#
# Usage:
#   cl                  fzf session picker
#   cl search <term>    search all Claude session history
#
set -eo pipefail

# --- search ---
if [[ "$1" == "search" ]]; then
  term="${2:?Usage: cl search <term>}"
  IFS=$'\t' read -r sid _ cwd < <(
    _cl search -- "$term" \
      | fzf --no-sort --delimiter=$'\t' --with-nth=4 --accept-nth=1,2,3 \
            --header='enter: open') || true
  [[ -z "$sid" ]] && exit 0
  if [[ ! -d "$cwd" ]]; then
    cwd=$(zoxide query -l | fzf --header="Original directory gone — pick a new one") || true
    [[ -z "$cwd" ]] && exit 0
  fi
  _cl open "$sid" --cwd "$cwd"
  exit 0
fi

# --- session picker ---
filter=$(tmux show-option -sv @cl_filter 2>/dev/null || echo "all")

header() {
  printf "[%s]  enter:open  ctrl-t:send  ctrl-g:filter  ctrl-f:search\n" "$filter"
  printf "ctrl-s:save  ctrl-o:fork  ctrl-x:close  ctrl-d:delete"
}

while true; do
  selection=$(_cl list --filter "$filter" \
    | fzf --no-sort --ansi \
          --expect=ctrl-d,ctrl-f,ctrl-g,ctrl-o,ctrl-s,ctrl-t,ctrl-x \
          --delimiter=$'\t' --with-nth=3 --accept-nth=1,2 \
          --header="$(header)" \
  ) || exit 0

  key=$(head -1 <<< "$selection")
  IFS=$'\t' read -r sid name <<< "$(tail -1 <<< "$selection")"

  case "$key" in
    ctrl-g)
      case "$filter" in
        all) filter=live ;; live) filter=today ;; today) filter=week ;; *) filter=all ;;
      esac
      tmux set-option -s @cl_filter "$filter" 2>/dev/null
      continue
      ;;
    ctrl-f)
      term=$(gum input --placeholder "Search sessions...")
      [[ -n "$term" ]] && exec cl search "$term"
      ;;
    ctrl-s)
      new_name=$(gum input --placeholder "Name" --value "$name")
      [[ -n "$new_name" ]] && _cl save "$sid" --name "$new_name"
      ;;
    ctrl-o)  _cl fork "$sid" && exit 0 ;;
    ctrl-x)  _cl close "$sid" ;;
    ctrl-d)
      gum confirm "Delete '$name'?" || continue
      _cl delete "$sid"
      ;;
    ctrl-t)
      prompt=$(gum write --header "Prompt for $name" --width 80)
      [[ -n "$prompt" ]] && _cl open "$sid" --prompt "$prompt" && exit 0
      ;;
    *)
      _cl open "$sid"
      exit 0
      ;;
  esac
done

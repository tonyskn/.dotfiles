#!/usr/bin/env bash
# vim:ft=bash
#
# cl — Claude session bookmark helper.
# Wraps `claude` with named bookmarks, tmux window management, and session search.
#
# Usage:
#   cl                              fzf bookmark picker (or scratch session if no bookmarks)
#   cl -n <name>                    new bookmarked session in current pane
#   cl -n <name> --resume <sid>     resume + bookmark an existing session
#   cl search <term>                search all Claude session history
#   claude ...                      plain delegation (via alias claude='cl --')
#
set -eo pipefail

# --- alias passthrough ---
# `alias claude='cl --'` routes here. Bare `claude` starts a scratch session.
if [[ "$1" == "--" ]]; then
  shift
  [[ $# -eq 0 ]] && exec command claude
fi

# --- search ---
if [[ "$1" == "search" ]]; then
  term="${2:?Usage: cl search <term>}"
  IFS=$'\t' read -r sid name cwd < <(
    _cl search "$term" \
      | fzf --no-sort --delimiter=$'\t' --with-nth=4 --accept-nth=1,2,3 \
            --header='enter: resume')
  [[ -z "$sid" ]] && exit 0
  if [[ "$name" == "unnamed" ]]; then
    name=$(gum input --placeholder "Name this session for your bookmarks")
    [[ -z "$name" ]] && exit 0
  fi
  _cl save "$sid" --name "$name" --cwd "${cwd:-$HOME}"
  _cl open "$sid"
  exit 0
fi

# --- bookmark picker ---
if [[ $# -eq 0 ]]; then
  [[ ! -f "$HOME/.claude/bookmarks.jsonl" ]] && exec command claude

  while true; do
    selection=$(_cl list \
      | fzf --no-sort \
            --expect=ctrl-d,ctrl-f,ctrl-r,ctrl-t,ctrl-x \
            --delimiter=$'\t' --with-nth=3 --accept-nth=1,2 \
            --header='enter: resume · ctrl-t: send · ctrl-f: search · ctrl-x: close · ctrl-d: delete · ctrl-r: rename' \
    ) || exit 0

    key=$(head -1 <<< "$selection")
    IFS=$'\t' read -r sid name <<< "$(tail -1 <<< "$selection")"

    case "$key" in
      ctrl-f)
        term=$(gum input --placeholder "Search sessions...")
        [[ -n "$term" ]] && exec cl search "$term"
        ;;
      ctrl-x)  _cl close "$sid" ;;
      ctrl-d)  gum confirm "Delete '$name'?" && _cl delete "$sid" || true ;;
      ctrl-r)
        new_name=$(gum input --placeholder "New name" --value "$name")
        [[ -n "$new_name" ]] && _cl save "$sid" --name "$new_name"
        ;;
      ctrl-t)
        prompt=$(gum write --header "Prompt for $name" --width 80)
        [[ -n "$prompt" ]] && _cl open "$sid" --prompt "$prompt" && exit 0
        ;;
      *)
        _cl open "$sid"
        exit 0
        ;;
    esac
  done
fi

# --- arg parsing ---
name=""
resume_id=""
pass_through=()

while [[ $# -gt 0 ]]; do
  case $1 in
    -n)          name="$2"; shift 2 ;;
    --resume|-r) resume_id="$2"; shift 2 ;;
    *)           pass_through+=("$1"); shift ;;
  esac
done

# No -n: plain delegation to claude
if [[ -z "$name" ]]; then
  exec command claude ${resume_id:+--resume "$resume_id"} "${pass_through[@]}"
fi

# Bookmarked session: save + launch in current pane
sid="${resume_id:-$(uuidgen | tr '[:upper:]' '[:lower:]')}"
_cl save "$sid" --name "$name" --cwd "$PWD"
[[ -n "${TMUX:-}" ]] && tmux rename-window "$(echo "$name" | tr '[:lower:]' '[:upper:]')"

if [[ -n "$resume_id" ]]; then
  exec command claude --resume "$sid" -n "$name" "${pass_through[@]}"
else
  exec command claude --session-id "$sid" -n "$name" "${pass_through[@]}"
fi

#!/usr/bin/env bash
# Set or clear a status icon prefix on the current tmux window name.
# Usage: tmux-marker [icon]   (no icon = clear)
[ -n "$TMUX_PANE" ] || exit 0

WINDOW_ID=$(tmux display-message -t "$TMUX_PANE" -p '#{window_id}' 2>/dev/null)
[ -n "$WINDOW_ID" ] || exit 0

TITLE=$(tmux display-message -t "$TMUX_PANE" -p '#W' 2>/dev/null)
# Strip only a known icon prefix — never a legitimate one-char first word
case "$TITLE" in
  "● "* | "○ "* | "◐ "*) TITLE="${TITLE#? }" ;;
esac

PREFIX="${1:+$1 }"
tmux rename-window -t "$WINDOW_ID" -- "${PREFIX}${TITLE}" 2>/dev/null
exit 0

#!/usr/bin/env bash
# Publishes Claude session state into tmux options, where _cl and the status bar read it.
#
#   tmux-marker [state]     working | idle | waiting | loop | attention | (none = clear)
#
# Claude hooks pipe event JSON on stdin, which carries session_id — that is what lets a
# session register itself, including ones started as plain `claude` rather than via cl.
# Invoked from a key binding there is no stdin, and only the marker is cleared.
[ -n "$TMUX_PANE" ] || exit 0

state="${1:-}"
sid=""

if [ ! -t 0 ]; then
  payload=$(cat)
  if [ -n "$payload" ]; then
    IFS=$'\t' read -r sid event < <(
      jq -r '[.session_id // "", .hook_event_name // ""] | @tsv' <<<"$payload" 2>/dev/null
    )
    [ -n "$state" ] || case "$event" in
      UserPromptSubmit) state=working ;;
      Stop)             state=idle    ;;
      Notification)     state=waiting ;;
    esac
  fi
fi

case "$state" in
  working)   icon="●" ;;
  idle)      icon="○" ;;
  waiting)   icon="◐" ;;
  loop)      icon="↻" ;;
  attention) icon="⚠" ;;
  *)         icon=""  ;;
esac

win=$(tmux display-message -t "$TMUX_PANE" -p '#{window_id}' 2>/dev/null) || exit 0
[ -n "$win" ] || exit 0

# One tmux invocation for every write.
set -- set-option -w -t "$win" @cl_icon "$icon" \
    ";" set-option -w -t "$win" @cl_active_at "$(date +%s)" \
    ";" set-option -p -t "$TMUX_PANE" @cl_pane 1

# Identity is write-once: /clear rotates the session id, and overwriting here would
# orphan a session _cl already owns. Only sessions cl didn't launch get tagged.
if [ -n "$sid" ] && [ -z "$(tmux display-message -t "$win" -p '#{@cl_sid}' 2>/dev/null)" ]; then
  set -- "$@" ";" set-option -w -t "$win" @cl_sid "$sid"
fi

tmux "$@" 2>/dev/null
exit 0

# vim:ft=zsh

# Completion system {{{

autoload -Uz compinit
compinit -C
zstyle ':completion:*' menu select
zstyle ':completion:*' matcher-list 'm:{a-zA-Z}={A-Za-z}'

# }}}

# Shell options {{{

bindkey -e
# Treat -, /, . etc. as word boundaries (like oh-my-zsh)
WORDCHARS=''
# Do not persist commands starting with *space* in zsh history
setopt inc_append_history extended_history hist_expire_dups_first hist_ignore_space
setopt extendedglob
HISTFILE=${XDG_DATA_HOME:-$HOME/.local/share}/zsh/zsh_history
[[ -d $HISTFILE:h ]] || mkdir -p $HISTFILE:h
SAVEHIST=100000  # History file size
HISTSIZE=20000   # Session history size

ulimit -n 2048

# }}}

# Key bindings {{{

autoload -Uz edit-command-line
zle -N edit-command-line
bindkey "\C-x\C-e" edit-command-line

# <c-z> runs fg
fg_widget() fg
zle -N fg_widget
bindkey '^z' fg_widget

# up/down arrow searches history matching current input
autoload -Uz up-line-or-beginning-search down-line-or-beginning-search
zle -N up-line-or-beginning-search
zle -N down-line-or-beginning-search
bindkey "^[[A" up-line-or-beginning-search
bindkey "^[[B" down-line-or-beginning-search

# }}}

# Environment {{{

eval $(/opt/homebrew/bin/brew shellenv)
export HOMEBREW_NO_ENV_HINTS=1

export EDITOR=nvim
alias vim=nvim
alias vi=nvim
export SHELL=zsh
export BROWSER=open
export PATH=~/.bin:~/.local/bin:$PATH
# Suppresses LOCALE warnings when launching VIM, among other things
export LC_ALL=en_US.UTF-8
export PARALLEL='--keep-order -j4 -C"\\\t"'

fpath=($HOMEBREW_PREFIX/share/zsh-completions $fpath)

# }}}

# Git aliases {{{

current_branch() { git branch --show-current; }

alias gst='git status'
alias gco='git checkout'
alias gb='git branch'
alias gc='git commit --verbose'
alias gc!='git commit --verbose --amend'
alias gca='git commit --verbose --all'
alias gca!='git commit --verbose --all --amend'
alias ggpush='git push origin "$(current_branch)"'
alias ggpush!='git push origin "$(current_branch)" --force-with-lease'
alias ggpull='git pull --rebase origin $(current_branch)'
alias gd='git diff'
alias gdi='git -c delta.side-by-side=false diff'
gfx() { git fixup "${1:-$(pbpaste)}"; }
gonto() { git rebase --onto origin/master "${1:?Usage: gonto <base-branch>}"; }

# }}}

# Aliases and functions {{{

export CLICOLOR=1
alias l='ls -lah'
alias ll='ls -lh'
# Aggregate stats from numbers on stdin
# Example: cat logs | grep endpoint | jq -r .took | stats
alias -g stats='datamash -H count 1 min 1 max 1 q3 1 perc:90 1 perc:98 1 perc:99 1 | column -t'

# run command in a new tmux pane, keeping cursor at current shell
# e.g. tmw watch -n 1 uptime
tmw() {
   tmux split-window -d -p 80 "$@"
}

gtimeout() {
  command gtimeout --foreground --preserve-status "$@"
}

table() {
  tail +4 | ghead -n -1 | sed 's/ *| */\t/g'
}

watch() {
  command watch -n1 "zsh -l -c \"source ~/.zshrc; $@\""
}

linview() {
  if [[ -n "$1" ]]; then
    ticket="$1"
  else
    branch=$(current_branch) || return
    ticket=$(echo "$branch" | sed -n 's#.*/\([a-zA-Z0-9]*-[0-9]*\)-.*#\1#p')
    if [[ -z "$ticket" ]]; then
      echo "No ticket ID found in branch: $branch"
      return 1
    fi
  fi
  url=$(linctl issue get "${ticket:u}" --json 2>/dev/null | jq -r '.url // empty')
  if [[ -z "$url" ]]; then
    echo "Could not find Linear issue: ${ticket:u}"
    return 1
  fi
  $BROWSER "$url" 2>/dev/null
}

claude() {
  local title=""
  local args=()
  while [[ $# -gt 0 ]]; do
    case $1 in
      -t) title="$2"; shift 2 ;;
      *) args+=("$1"); shift ;;
    esac
  done
  [[ -z "$title" ]] && title="${PWD##*/}"
  [[ -n "$TMUX" ]] && tmux rename-window "${title:u}"
  command claude "${args[@]}"
}

sample() {
  gsort -R | head -$1
}

swap() {
  local TMP="_$1.tmp_"
  mv $1 $TMP && mv $2 $1 && mv $TMP $2
}

# }}}

# Runtime bootstrapping {{{

# Attach to an already running tmux session or create new one
# unless running in a virtual console, SSH, tmux, or IDE terminal
if [[ -f /usr/bin/tmux || -f $HOMEBREW_PREFIX/bin/tmux ]]; then
  tty | grep -qo /dev/tty.$ || test "$SSH_TTY" || test "$TMUX" || ps -p $PPID | grep 'IntelliJ\|WebStorm' > /dev/null \
    || tmux attach 2>/dev/null || tmux new-session
fi

# zoxide
eval "$(zoxide init zsh)"

# sdkman (must be near end)
export SDKMAN_DIR="$HOME/.sdkman"
[[ -s "$HOME/.sdkman/bin/sdkman-init.sh" ]] && source "$HOME/.sdkman/bin/sdkman-init.sh"

# fzf keybindings: Ctrl+R (history), Ctrl+T (file picker)
export FZF_DEFAULT_COMMAND='fd --type f --hidden --exclude .git'
export FZF_CTRL_T_COMMAND="$FZF_DEFAULT_COMMAND"
export FZF_ALT_C_COMMAND='zoxide query -l'
source $HOMEBREW_PREFIX/opt/fzf/shell/key-bindings.zsh
source $HOMEBREW_PREFIX/opt/fzf/shell/completion.zsh
# Rebind fzf cd-widget from Alt+C (unreliable in tmux) to Ctrl+F
bindkey -rM emacs '\ec'
bindkey -M emacs '^F' fzf-cd-widget

# Starship prompt
eval "$(starship init zsh)"

# }}}
